# Server only. This file is a template; use environment variables or source .env.
DARI_LLM_PROVIDER=gemini
# Numbered-application browser translation stays local and bypasses Gemini.
DARI_TRANSLATION_MODEL=dari-hymt2:1.8b
DARI_GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# LOW reasoning for interactive intake; set default to use provider defaults.
DARI_GEMINI_INTAKE_THINKING=low
# Models must already exist in this Hugging Face cache. Never downloads at runtime.
# HF_HOME=/absolute/path/to/model-cache

# Optional on supported Macs after validation. Default: cpu
# DARI_PII_DEVICE=mps
