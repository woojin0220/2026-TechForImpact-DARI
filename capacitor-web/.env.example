# 브라우저 개발 시에만 필요하다면 주석을 해제하세요.
# VITE_DARI_API_URL=http://localhost:8765

# 로그인·커뮤니티용 Supabase 프로젝트 설정 (docs/PLATFORM_AUTH.md 참고)
# 비워 두면 신청서는 그대로 동작하고, 커뮤니티 탭에 "로그인이 설정되지 않았어요"가 표시됩니다.
# anon 키는 공개용 키입니다. service_role 키는 절대 여기에 넣지 마세요.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon public key>
