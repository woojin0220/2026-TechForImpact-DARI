{
  "name": "dari-capacitor-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types scripts/build-translation-profiles.mjs && node scripts/build-procedure-i18n.mjs && vite",
    "build:web-feedback": "npm run build -- --mode feedback-web",
    "build:feedback": "npm run build -- --mode feedback",
    "build": "node --experimental-strip-types scripts/build-translation-profiles.mjs && node scripts/build-procedure-i18n.mjs && tsc -b && vite build",
    "procedure:i18n": "node scripts/build-procedure-i18n.mjs",
    "test": "node --experimental-strip-types scripts/audit-arabic-i18n.mjs && node --experimental-strip-types --test tests/*.test.mjs",
    "preview": "vite preview",
    "cap:sync": "npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "audit:ar": "node --experimental-strip-types scripts/audit-arabic-i18n.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/share": "^8.0.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.119.0",
    "cfb": "^1.2.2",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
