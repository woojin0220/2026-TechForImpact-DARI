{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dari.example/schemas/input.schema.json",
  "title": "DARI verification input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "data_classification",
    "source",
    "translation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "data_classification": {
      "enum": [
        "synthetic",
        "deidentified_research"
      ]
    },
    "source": {
      "$ref": "#/$defs/document"
    },
    "translation": {
      "$ref": "#/$defs/document"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "text"
      ],
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 20000
        }
      }
    }
  }
}
