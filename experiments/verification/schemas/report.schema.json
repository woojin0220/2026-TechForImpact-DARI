{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dari.example/schemas/report.schema.json",
  "title": "DARI verification report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "strategy_id",
    "status",
    "findings",
    "errors",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "case_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "strategy_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "status": {
      "enum": [
        "completed",
        "issues_found",
        "indeterminate",
        "invalid_input"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "case_id": {
            "type": "string"
          },
          "findings": {
            "not": {
              "contains": {
                "properties": {
                  "status": {
                    "enum": [
                      "candidate",
                      "confirmed",
                      "abstained"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          },
          "errors": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "issues_found"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "case_id": {
            "type": "string"
          },
          "findings": {
            "contains": {
              "properties": {
                "status": {
                  "enum": [
                    "candidate",
                    "confirmed"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "minContains": 1,
            "not": {
              "contains": {
                "properties": {
                  "status": {
                    "const": "abstained"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          },
          "errors": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "indeterminate"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "case_id": {
            "type": "string"
          },
          "errors": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "invalid_input"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "findings": {
            "maxItems": 0
          },
          "errors": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "type",
        "related_types",
        "change",
        "severity",
        "source_span",
        "translation_span",
        "evidence_absence_reason",
        "confidence",
        "status",
        "detectors",
        "rationale"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "$ref": "#/$defs/findingType"
        },
        "related_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/findingType"
          }
        },
        "change": {
          "enum": [
            "added",
            "removed",
            "changed",
            "swapped"
          ]
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "source_span": {
          "oneOf": [
            {
              "$ref": "#/$defs/sourceSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "translation_span": {
          "oneOf": [
            {
              "$ref": "#/$defs/translationSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_absence_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 500
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "enum": [
            "candidate",
            "confirmed",
            "rejected",
            "abstained"
          ]
        },
        "detectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "properties": {
                "source_span": {
                  "$ref": "#/$defs/sourceSpan"
                }
              }
            },
            {
              "properties": {
                "translation_span": {
                  "$ref": "#/$defs/translationSpan"
                }
              }
            }
          ]
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "omission"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "change": {
                "const": "removed"
              },
              "source_span": {
                "$ref": "#/$defs/sourceSpan"
              },
              "translation_span": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "unsupported_addition"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "change": {
                "const": "added"
              },
              "source_span": {
                "type": "null"
              },
              "translation_span": {
                "$ref": "#/$defs/translationSpan"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "not": {
                  "enum": [
                    "omission",
                    "unsupported_addition"
                  ]
                }
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "source_span": {
                "$ref": "#/$defs/sourceSpan"
              },
              "translation_span": {
                "$ref": "#/$defs/translationSpan"
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "source_span": {
                    "type": "null"
                  }
                },
                "required": [
                  "source_span"
                ]
              },
              {
                "properties": {
                  "translation_span": {
                    "type": "null"
                  }
                },
                "required": [
                  "translation_span"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "evidence_absence_reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          },
          "else": {
            "properties": {
              "evidence_absence_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "abstained"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "confidence": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "confidence": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "findingType": {
      "enum": [
        "omission",
        "unsupported_addition",
        "negation_flip",
        "certainty_shift",
        "source_attribution_change",
        "actor_role_change",
        "identity_value_change",
        "temporal_change",
        "causality_change",
        "harm_strength_change"
      ]
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "unit_id",
        "start",
        "end",
        "quote"
      ],
      "properties": {
        "document": {
          "enum": [
            "source",
            "translation"
          ]
        },
        "unit_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "sourceSpan": {
      "allOf": [
        {
          "$ref": "#/$defs/span"
        },
        {
          "properties": {
            "document": {
              "const": "source"
            },
            "unit_id": {
              "const": "source:0"
            }
          }
        }
      ]
    },
    "translationSpan": {
      "allOf": [
        {
          "$ref": "#/$defs/span"
        },
        {
          "properties": {
            "document": {
              "const": "translation"
            },
            "unit_id": {
              "const": "translation:0"
            }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "stage",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "stage": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "config_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "prompt_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_version",
        "dataset_version",
        "dataset_digest",
        "git_commit",
        "config_digest",
        "experiment_fingerprint",
        "components",
        "random_seed",
        "hardware_class",
        "started_at",
        "duration_ms"
      ],
      "properties": {
        "pipeline_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "dataset_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "dataset_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "config_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "experiment_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "random_seed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "hardware_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
