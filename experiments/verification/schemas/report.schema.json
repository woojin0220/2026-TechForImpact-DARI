{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dari.example/schemas/verification-report-v1.json",
  "title": "DARI verification report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "strategy_id",
    "status",
    "findings",
    "errors",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "strategy_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "status": {
      "enum": [
        "completed",
        "issues_found",
        "indeterminate",
        "invalid_input"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "type",
        "related_types",
        "change",
        "severity",
        "source_span",
        "translation_span",
        "confidence",
        "status",
        "detector",
        "rationale"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "$ref": "#/$defs/findingType"
        },
        "related_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/findingType"
          }
        },
        "change": {
          "enum": [
            "added",
            "removed",
            "changed",
            "swapped"
          ]
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "source_span": {
          "oneOf": [
            {
              "$ref": "#/$defs/span"
            },
            {
              "type": "null"
            }
          ]
        },
        "translation_span": {
          "oneOf": [
            {
              "$ref": "#/$defs/span"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "enum": [
            "candidate",
            "confirmed",
            "rejected",
            "abstained"
          ]
        },
        "detector": {
          "$ref": "#/$defs/component"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "anyOf": [
        {
          "properties": {
            "source_span": {
              "$ref": "#/$defs/span"
            }
          }
        },
        {
          "properties": {
            "translation_span": {
              "$ref": "#/$defs/span"
            }
          }
        }
      ]
    },
    "findingType": {
      "enum": [
        "omission",
        "unsupported_addition",
        "negation_flip",
        "certainty_shift",
        "source_attribution_change",
        "actor_role_change",
        "identity_value_change",
        "temporal_change",
        "causality_change",
        "harm_strength_change"
      ]
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "unit_id",
        "start",
        "end",
        "quote"
      ],
      "properties": {
        "document": {
          "enum": [
            "source",
            "translation"
          ]
        },
        "unit_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "stage",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "stage": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_version",
        "dataset_version",
        "git_commit",
        "config_digest",
        "components",
        "started_at",
        "duration_ms"
      ],
      "properties": {
        "pipeline_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "dataset_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "config_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "prompt_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_revision": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "random_seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
